{
  "name": "extra-education-for-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Недельный буткемп Fastify + Prisma + PostgreSQL для фронтенд-разработчика",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "prisma": "6.19.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
